# Copy to .env (never commit .env) or export these variables in the shell.
# Unity local defaults to http://localhost:8080/api when omitted.
MYDEFENSE_ENV=local
MYDEFENSE_API_BASE_URL=http://localhost:8080/api

# Create a Fusion 2 App ID in the Photon Dashboard and provide it locally.
MYDEFENSE_PHOTON_APP_ID=

# Spring Boot deployment variables are consumed by the server process, not Unity.
DB_URL=jdbc:h2:mem:testdb;MODE=MySQL
DB_USERNAME=sa
DB_PASSWORD=
